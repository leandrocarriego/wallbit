# Copiá este archivo a .env (`make init` lo hace por vos). Valores solo para desarrollo local.
ENV=local

# PostgreSQL
POSTGRES_USER=cierre
POSTGRES_PASSWORD=cierre
POSTGRES_DB=cierre
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://cierre:cierre@postgres:5432/cierre

# RabbitMQ
RABBITMQ_DEFAULT_USER=cierre
RABBITMQ_DEFAULT_PASS=cierre
RABBITMQ_URL=amqp://cierre:cierre@rabbitmq:5672//

# Web (consola del contador) y mobile (simulador del usuario)
NEXT_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Grafana (sin login en el prototipo: acceso anónimo como admin)
GF_SECURITY_ADMIN_PASSWORD=cierre
