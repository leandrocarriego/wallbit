# Copy this file to .env (`make init` does it for you). Local development values only.
ENV=local

# PostgreSQL
POSTGRES_USER=wallbit
POSTGRES_PASSWORD=wallbit
POSTGRES_DB=wallbit
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://wallbit:wallbit@postgres:5432/wallbit

# RabbitMQ
RABBITMQ_DEFAULT_USER=wallbit
RABBITMQ_DEFAULT_PASS=wallbit
RABBITMQ_URL=amqp://wallbit:wallbit@rabbitmq:5672//

# Web (accountant console) and mobile (user simulator)
NEXT_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000

# Grafana (no login in the prototype: anonymous admin access)
GF_SECURITY_ADMIN_PASSWORD=wallbit
